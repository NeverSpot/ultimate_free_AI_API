{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/v1",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

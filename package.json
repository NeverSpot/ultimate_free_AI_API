{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "OpenAI-compatible gateway that pools free-tier provider keys with rate-limit-aware routing and failover.",
  "main": "dist/index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "registry:list": "node --env-file-if-exists=.env --import tsx scripts/registry-list.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "test:watch": "node --import tsx --test --watch",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run -s typecheck && npm run -s lint && npm run -s format:check && npm run -s test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.8.0",
  "type": "commonjs",
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8"
  }
}

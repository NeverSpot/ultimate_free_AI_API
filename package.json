{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "OpenAI-compatible gateway that pools free-tier provider keys with rate-limit-aware routing and failover.",
  "main": "dist/index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "registry:list": "node --env-file-if-exists=.env --import tsx scripts/registry-list.ts",
    "registry:sync": "node --env-file-if-exists=.env --import tsx scripts/registry-sync.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "test:int": "node --import tsx --test --test-concurrency=1 test/integration/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch",
    "eval": "node --import tsx src/eval/run.ts",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run -s typecheck && npm run -s lint && npm run -s format:check && npm run -s test",
    "load": "node --import tsx load/run.ts",
    "load:ci": "node --import tsx load/run.ts --env ci",
    "mock:upstream": "node --import tsx load/mock-upstream.ts",
    "mock:down": "node --import tsx load/mock-down.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "sex": "node scripts/sex.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "artillery": "^2.0.34",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.8.0",
  "type": "commonjs",
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}

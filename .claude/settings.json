{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(npm publish *)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune*)",
      "Bash(rm -rf *)",
      "Bash(printenv*)"
    ],
    "allow": [
      "Bash(npm run -s verify)",
      "Bash(npm run -s test:*)",
      "Bash(npm run -s typecheck)",
      "Bash(npm run -s lint)",
      "Bash(npm run -s db:up)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ]
  }
}

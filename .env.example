# Copy to .env for development. NEVER commit .env or .env.local.
PORT=8080
NGINX_PORT=80
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:55432/gateway
REDIS_URL=redis://127.0.0.1:6379

# Provider keys. Comma-separated: MULTIPLE keys per provider is the whole point.
NVIDIA_NIM_KEYS=
OPENROUTER_KEYS=
TOKENHARBOR_KEYS=

# Block 19: encryption key for at-rest provider key encryption (32+ chars)
MASTER_ENCRYPTION_KEY=your-32-char-minimum-master-key-here
ADMIN_TOKEN=change-me-in-real-env
LOG_LEVEL=info
NODE_ENV=development

# JWT session signing secret (HS256), min 32 chars. Required in production. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- User auth: OAuth + email OTP ---
# Where the browser is sent after OAuth, and the origin the API trusts for redirects.
FRONTEND_URL=http://localhost:3000
# Public origin of this API. Provider consoles must list:
#   {OAUTH_CALLBACK_BASE}/v1/auth/oauth/google/callback
#   {OAUTH_CALLBACK_BASE}/v1/auth/oauth/github/callback
OAUTH_CALLBACK_BASE=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email OTP for signup
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# HMAC pepper for stored codes. Defaults to MASTER_ENCRYPTION_KEY when empty.
OTP_PEPPER=
# Development only: echo the code in the register response. Ignored in production.
OTP_DEV_RETURN_CODE=true

# Mail delivery: console (logs the code, dev only) | smtp | resend.
# NODE_ENV=production refuses to boot with console.
MAIL_TRANSPORT=console
MAIL_FROM="Ultimate Free AI <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Copy to .env for development. NEVER commit .env or .env.local.
PORT=8080
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:55432/gateway
REDIS_URL=redis://127.0.0.1:6379

# Provider keys. Comma-separated: MULTIPLE keys per provider is the whole point.
NVIDIA_NIM_KEYS=
OPENROUTER_KEYS=
TOKENHARBOR_KEYS=

MASTER_ENCRYPTION_KEY=
ADMIN_TOKEN=change-me-in-real-env
LOG_LEVEL=info
NODE_ENV=development

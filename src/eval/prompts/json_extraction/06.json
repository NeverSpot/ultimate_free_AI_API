{
  "id": "json_06",
  "bucket": "json_extraction",
  "prompt": "Extract the requested data from the following text as a JSON object adhering to the schema:\n\nFilm: \"Inception\" directed by Christopher Nolan, released in 2010, grossed 836.8 million dollars, starring [\"Leonardo DiCaprio\", \"Joseph Gordon-Levitt\"].\n\nOutput only valid JSON.",
  "referenceAnswer": "{\n  \"title\": \"Inception\",\n  \"director\": \"Christopher Nolan\",\n  \"releaseYear\": 2010,\n  \"boxOfficeMillions\": 836.8,\n  \"cast\": [\n    \"Leonardo DiCaprio\",\n    \"Joseph Gordon-Levitt\"\n  ]\n}",
  "schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "director": {
        "type": "string"
      },
      "releaseYear": {
        "type": "integer"
      },
      "boxOfficeMillions": {
        "type": "number"
      },
      "cast": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["title", "director", "releaseYear", "boxOfficeMillions", "cast"]
  }
}

{
  "id": "json_12",
  "bucket": "json_extraction",
  "prompt": "Extract the requested data from the following text as a JSON object adhering to the schema:\n\nVehicle: Tesla Model 3, year 2023, mileage 15000, fuelType \"electric\".\n\nOutput only valid JSON.",
  "referenceAnswer": "{\n  \"make\": \"Tesla\",\n  \"model\": \"Model 3\",\n  \"year\": 2023,\n  \"mileage\": 15000,\n  \"fuelType\": \"electric\"\n}",
  "schema": {
    "type": "object",
    "properties": {
      "make": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "mileage": {
        "type": "integer"
      },
      "fuelType": {
        "type": "string"
      }
    },
    "required": ["make", "model", "year", "mileage", "fuelType"]
  }
}

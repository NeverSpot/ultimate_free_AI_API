  "schema": {
    "type": "object",
    "properties": {
      "reservationId": {
        "type": "string"
      },
      "guestName": {
        "type": "string"
      },
      "nights": {
        "type": "integer"
      },
      "roomType": {
        "type": "string"
      },
      "totalPaid": {
        "type": "number"
      }

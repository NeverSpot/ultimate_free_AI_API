{
  "id": "json_16",
  "bucket": "json_extraction",
  "prompt": "Extract the requested data from the following text as a JSON object adhering to the schema:\n\nHotel reservation RES-5512 for guest David Kim, 3 nights in a \"Deluxe Suite\", total amount 750.00.\n\nOutput only valid JSON.",

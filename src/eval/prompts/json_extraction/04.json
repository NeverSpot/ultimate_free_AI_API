  "referenceAnswer": "{\n  \"street\": \"742 Evergreen Terrace\",\n  \"city\": \"Springfield\",\n  \"state\": \"OR\",\n  \"postalCode\": \"97477\",\n  \"country\": \"USA\"\n}",

# Base URL of the gateway API, including the /v1 prefix.
# Baked in at BUILD time (Next.js inlines NEXT_PUBLIC_*), so set it before `npm run build`.
#
# Leave it unset for the deployed app: the default is a same-origin `/v1`, and the
# root `vercel.json` routes `/v1/*` to the gateway service on the same domain.
#
# Local `next dev` runs on :3000 while the gateway listens on :8080, so set it here:
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

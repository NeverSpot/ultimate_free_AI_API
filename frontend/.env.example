# --- Deployed build ---------------------------------------------------------
# Optional. Leave it unset for the default same-origin `/v1`: `vercel.json`
# routes `/v1/*` to the gateway service, so the session cookie stays first-party.
# Set it only when the gateway lives on another origin; include the /v1 prefix.
# Next.js inlines NEXT_PUBLIC_* at build time, so set it before `npm run build`.
# NEXT_PUBLIC_API_URL=https://api.example.com/v1

# --- Local development ------------------------------------------------------
# `next dev` rewrites `/v1/*` to the gateway, matching production. The default
# target is http://localhost:8080; override it when the gateway listens
# elsewhere. This is read by next.config.ts, not by the browser.
# API_PROXY_TARGET=http://localhost:8080
#
# You normally do not need NEXT_PUBLIC_API_URL in development. Setting it makes
# the browser call that origin directly, bypassing the rewrite; the session
# cookie is then cross-origin unless the gateway is configured to allow it.
